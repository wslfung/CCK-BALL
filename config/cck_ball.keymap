#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    tmpt: tmpt {
        compatible = "zmk,behavior-hold-tap";
        label = "TMPT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        require-prior-idle-ms = <150>;
        flavor = "tap-preferred";
        quick-tap-ms = <125>;
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC         &kp N1         &kp N2            &kp N3            &kp N4         &kp N5     &kp N6     &kp N7         &kp N8        &kp N9        &kp N0            &kp MINUS
&kp TAB         &kp Q          &kp W             &kp E             &kp R          &kp T      &kp Y      &kp U          &kp I         &kp O         &kp P             &kp BSLH
&kp BACKSPACE   &tmpt LCTRL A  &tmpt LEFT_ALT S  &tmpt LEFT_GUI D  &tmpt LSHFT F  &kp G      &kp H      &tmpt RSHFT J  &tmpt RGUI K  &tmpt RALT L  &tmpt RCTRL SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z          &kp X             &kp C             &kp V          &kp B      &kp N      &kp M          &kp COMMA     &kp DOT       &kp SLASH         &kp RIGHT_SHIFT
&none           &kp LS(LC(C))  &kp LS(LC(V))     &mo 1             &mo 2          &kp ENTER  &mkp LCLK  &mo 1          &kp SPACE     &mo 4         &kp RC(PG_UP)     &kp RC(PAGE_DOWN)
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav {
            bindings = <
&kp F12  &kp F1     &kp F2  &kp F3  &kp F4           &kp F5  &kp F6      &kp F7          &kp F8            &kp F9             &kp F10    &kp F11
&trans   &kp GRAVE  &trans  &trans  &kp PRINTSCREEN  &trans  &kp INSERT  &kp HOME        &kp UP_ARROW      &kp END            &kp PG_UP  &trans
&trans   &trans     &trans  &trans  &trans           &trans  &kp DELETE  &kp LEFT_ARROW  &kp DOWN_ARROW    &kp RIGHT_ARROW    &kp PG_DN  &kp RGUI
&trans   &trans     &trans  &trans  &trans           &trans  &kp MINUS   &kp EQUAL       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans     &trans
&trans   &trans     &trans  &trans  &trans           &trans  &trans      &trans          &kp ENTER         &trans             &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
            label = "nav";
        };

        num {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &kp N8        &trans        &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N7        &kp N8        &kp N9        &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS   &kp KP_EQUAL
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_DOT    &kp NUMBER_0  &trans        &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
            label = "num";
        };

        sys {
            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp CAPS  &kp KP_NUMLOCK  &kp SCROLLLOCK  &trans  &trans  &out OUT_TOG
&trans       &trans        &trans        &trans        &trans        &trans        &trans    &trans          &trans          &trans  &trans  &trans
&trans       &trans        &trans        &trans        &trans        &trans        &trans    &trans          &trans          &trans  &trans  &trans
&trans       &trans        &trans        &bt BT_CLR    &trans        &trans        &trans    &trans          &trans          &trans  &trans  &trans
&bootloader  &trans        &trans        &trans        &trans        &trans        &trans    &trans          &trans          &trans  &trans  &bootloader
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
            label = "sys";
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp RCLK  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        one_plus_two_equals_three {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
